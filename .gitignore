*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.log
*.pdf
*.png
*.svg
*.jpg
*.jpeg

# Curated media rendered on the project home page.
!assets/
!assets/figures/
!assets/figures/*.png
!assets/atlases/
!assets/atlases/*.gif
