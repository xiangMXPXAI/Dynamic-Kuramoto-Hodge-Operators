# Python and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
.idea/
.vscode/

# External datasets and frozen checkpoints are intentionally excluded from source control.
experiments/**/data/
experiments/**/cochains/data/
experiments/**/figures/

# Generated training, evaluation, and visualization artifacts.
experiments/**/runs/
experiments/**/reports/
experiments/**/cache/
/reports/

# Local reading material.
/algorithm_reference/
/template_reference/
# Local historical copies retained outside the public source tree.
/baselines/

